{
  "projectId": "133dad7c-bee4-4548-aabb-9b2b72c0f396",
  "pkg": "@cyanium/ui",
  "shape": "package",
  "buildCmd": "pnpm -F \"@cyanium/ui...\" -F \"@cyanium/kits...\" build && npx -y @tailwindcss/cli@4 -i .design-sync/css-entry.css -o packages/ui/dist/_ds-compiled.css --minify",
  "cssEntry": "dist/_ds-compiled.css",
  "extraEntries": ["@cyanium/kits"],
  "extraFonts": ["../../.design-sync/fonts/fonts.css"],
  "readmeHeader": ".design-sync/conventions.md",
  "componentSrcMap": {
    "FinanceApp": "../kits/src/finance/finance-app.tsx",
    "LandingPage": "../kits/src/landing/landing-page.tsx",
    "AiChatApp": "../kits/src/ai/ai-chat-app.tsx"
  },
  "overrides": {
    "Modal": { "cardMode": "single", "viewport": "480x360" },
    "Dialog": { "cardMode": "single", "viewport": "480x360" },
    "Dropdown": { "cardMode": "single", "viewport": "360x200" },
    "DropdownMenu": { "cardMode": "single", "viewport": "360x200" },
    "Tooltip": { "cardMode": "single", "viewport": "360x160" },
    "DataTable": { "cardMode": "column" },
    "Accordion": { "cardMode": "column" },
    "Alert": { "cardMode": "column" },
    "Banner": { "cardMode": "column" },
    "EmptyState": { "cardMode": "column" },
    "Eyebrow": { "cardMode": "column" },
    "FeatureCard": { "cardMode": "column" },
    "Heading": { "cardMode": "column" },
    "Pagination": { "cardMode": "column" },
    "Panel": { "cardMode": "column" },
    "ProgressBar": { "cardMode": "column" },
    "RadioGroup": { "cardMode": "column" },
    "SectionHead": { "cardMode": "column" },
    "SegmentedControl": { "cardMode": "column" },
    "Switch": { "cardMode": "column" },
    "Tabs": { "cardMode": "column" },
    "Text": { "cardMode": "column" },
    "Textarea": { "cardMode": "column" },
    "FinanceApp": { "cardMode": "single", "viewport": "1200x800" },
    "AiChatApp": { "cardMode": "single", "viewport": "1200x800" },
    "LandingPage": { "cardMode": "single", "viewport": "1200x600" },
    "MarketingShell": { "cardMode": "single", "viewport": "1200x600" }
  }
}
